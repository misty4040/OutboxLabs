# Application Environment
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5173

# Database (MySQL)
DATABASE_URL=mysql://root:rootpassword@127.0.0.1:3306/reachinbox

# Redis
REDIS_URL=redis://127.0.0.1:6379

# Elasticsearch
ELASTICSEARCH_URL=http://127.0.0.1:9200

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/auth/google/callback

# Slack OAuth
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=http://localhost:5000/api/slack/callback

# SMTP (Ethereal Email - will auto-generate if credentials are empty in development)
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="ReachInbox Outreach <no-reply@reachinbox.ai>"

# Worker & Scheduling Controls
WORKER_CONCURRENCY=5
EMAIL_DELAY_MS=2000
MAX_EMAILS_PER_HOUR=200

# Security & Session
SESSION_SECRET=reachinbox_super_secret_jwt_session_key_32bytes_min_length
